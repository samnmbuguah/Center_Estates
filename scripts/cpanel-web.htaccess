RewriteEngine On

# Authentication cookies are Secure and cannot work from an HTTP frontend.
# 1) Force HTTPS while preserving the hostname so each site keeps its own
#    origin (centerestates.com and the sales-only centerestates.co.ke).
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# 2) Canonical host: only the primary .com and the .co.ke storefront are
#    served; www or any other host is repaired to the primary domain.
RewriteCond %{HTTP_HOST} !^(centerestates\.com|centerestates\.co\.ke)$ [NC]
RewriteRule ^ https://centerestates.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/_next/static/" ce_static_asset=1
  Header always set Cache-Control "private, no-cache, no-store, max-age=0, must-revalidate" env=!ce_static_asset
  Header always set CDN-Cache-Control "no-store" env=!ce_static_asset
  Header always set Cache-Control "public, max-age=31536000, immutable" env=ce_static_asset
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
    Header always unset CDN-Cache-Control
  </FilesMatch>
</IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
<IfModule php8_module>
   php_value error_log "/home2/monitori/logs/php.error.log"
   php_flag log_errors On
</IfModule>
<IfModule lsapi_module>
   php_value error_log "/home2/monitori/logs/php.error.log"
   php_flag log_errors On
</IfModule>
# END cPanel-generated php ini directives, do not edit

# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION BEGIN
PassengerAppRoot "/home2/monitori/centerestates.com"
PassengerBaseURI "/"
PassengerNodejs "/home2/monitori/nodevenv/centerestates.com/24/bin/node"
PassengerAppType node
PassengerStartupFile app.js
# DO NOT REMOVE. CLOUDLINUX PASSENGER CONFIGURATION END
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION BEGIN
<IfModule Litespeed>
</IfModule>
# DO NOT REMOVE OR MODIFY. CLOUDLINUX ENV VARS CONFIGURATION END
