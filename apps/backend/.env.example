DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.example.com
DB_ENGINE=django.db.backends.postgresql
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
SEED_DEMO_DATA=false
SEED_ADMIN_USERNAME=admin

# Optional S3-compatible object storage for user media (3D models, renderings,
# floor plans, documents). Leave AWS_STORAGE_BUCKET_NAME blank to keep media on
# the local filesystem. Works with AWS S3, Cloudflare R2, DigitalOcean Spaces
# and Backblaze B2 (set AWS_S3_ENDPOINT_URL for non-AWS providers).
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_QUERYSTRING_AUTH=false
AWS_DEFAULT_ACL=
