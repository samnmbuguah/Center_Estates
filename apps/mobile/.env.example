# Copy to apps/mobile/.env. Expo auto-loads EXPO_PUBLIC_* vars.
#
# A physical device cannot reach the backend at "localhost" (that's the phone
# itself). Use your computer's LAN IP and run Django on 0.0.0.0:8000.
# Find your IP: Linux `hostname -I` · macOS `ipconfig getifaddr en0`.
EXPO_PUBLIC_API_BASE=http://192.168.1.100:8000
