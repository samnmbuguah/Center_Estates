# Expo dev server for USABILITY TESTING — serves the mobile app to Expo Go
# over tunnel (ngrok) and LAN so testers can test on physical devices anywhere.
FROM node:22-slim AS app
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable
WORKDIR /repo

# Copy workspace configuration and dependencies
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
COPY apps/mobile/package.json ./apps/mobile/

RUN pnpm install --filter @monitoring/mobile... --config.minimum-release-age=0 || true

COPY . .

WORKDIR /repo/apps/mobile

ENV CI=1
ENV EXPO_NO_DEVTOOLS=1
EXPOSE 8081

CMD ["npx", "expo", "start", "--go", "--tunnel", "ngrok", "--port", "8081"]

