{
  "name": "center-estates-erp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=web",
    "build": "npm run build --workspace=web",
    "check:bundles": "node scripts/check_frontend_bundles.mjs",
    "lint": "npm run lint --workspace=web",
    "e2e": "playwright test",
    "e2e:ui": "playwright test tests/e2e/ui-components.spec.ts --project=desktop-chromium",
    "e2e:roles": "playwright test tests/e2e/roles.spec.ts --project=desktop-chromium",
    "e2e:story": "playwright test --grep",
    "e2e:headed": "playwright test --headed",
    "backend:check": "apps/backend/.venv/bin/python apps/backend/manage.py check",
    "backend:test": "cd apps/backend && .venv/bin/python manage.py test",
    "backend:test:e2e": "cd apps/backend && DB_NAME=center_estates_test .venv/bin/python manage.py test --settings=config.settings_test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
